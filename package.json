{
  "name": "mon-portfolio",
  "homepage": "https://kevgenga.github.io/portfolio/",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "artwork-admin": "node tools/artwork-admin/server.mjs",
    "artwork-admin:test": "node tools/artwork-admin/tests/integration.mjs && npm run production-time:test",
    "production-time:test": "node --test tools/artwork-admin/tests/production-time.test.mjs && node tools/artwork-admin/tests/production-time-integration.mjs",
    "production-time:browser-test": "node tools/artwork-admin/tests/production-time-browser.mjs",
    "animation-admin:test": "node tools/artwork-admin/tests/animation-integration.mjs && node --test tools/artwork-admin/tests/presentation-settings.test.mjs",
    "manga-admin:test": "node tools/artwork-admin/tests/manga-integration.mjs && node --test src/utils/languageLabels.test.mjs tools/artwork-admin/tests/manga-language-ui.test.mjs tools/artwork-admin/tests/manga-duplicate-page.test.mjs tools/artwork-admin/tests/manga-replace-page.test.mjs tools/artwork-admin/tests/manga-reorder-page.test.mjs tools/artwork-admin/tests/manga-audit.test.mjs tools/artwork-admin/tests/manga-production.test.mjs",
    "manga-production:test": "node --test tools/artwork-admin/tests/manga-production.test.mjs",
    "manga-production:browser-test": "node tools/artwork-admin/tests/manga-production-browser.mjs",
    "production-groups:test": "node --test tools/artwork-admin/tests/production-groups.test.mjs",
    "production-groups:browser-test": "node tools/artwork-admin/tests/production-groups-browser.mjs",
    "production-time:public-test": "node --test src/utils/publicProductionTime.test.mjs",
    "production-time:public-browser-test": "node tests/public-production-time-browser.mjs",
    "media-audit:test": "node --test tools/artwork-admin/tests/media-audit.test.mjs",
    "contact-form:test": "node --test src/services/contactForm.test.mjs src/services/contactValidation.test.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@fancyapps/ui": "^5.0.36",
    "framer-motion": "^12.42.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-ga4": "^3.0.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "gh-pages": "^6.3.0",
    "globals": "^15.15.0",
    "postcss": "^8.5.20",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.3"
  }
}
